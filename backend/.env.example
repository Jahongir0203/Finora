# Namuna. Haqiqiy qiymatlar prod'da Vault/KMS'dan keladi — bu faylga secret yozilmaydi.
FINORA_ENV=dev
FINORA_DATABASE_URL=postgresql+asyncpg://finora_app:CHANGE_ME@localhost:5432/finora
FINORA_REDIS_URL=redis://localhost:6379/0
# ES256 (P-256) private key, PEM
FINORA_JWT_PRIVATE_KEY=
# 32 bayt tasodifiy, base64:  python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
FINORA_OTP_HMAC_KEY=
FINORA_BLIND_INDEX_KEY=
FINORA_FIELD_ENCRYPTION_KEY=
FINORA_REFRESH_TOKEN_PEPPER=
FINORA_URL_SIGNING_KEY=
FINORA_CLAMAV_HOST=
FINORA_SECURITY_CONTACT=mailto:security@example.com
FINORA_DOCS_ENABLED=true
FINORA_ENFORCE_HTTPS=false
