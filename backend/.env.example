# Namuna. Haqiqiy qiymatlar prod'da Vault/KMS'dan keladi — bu faylga secret yozilmaydi.
FINORA_ENV=dev
FINORA_DATABASE_URL=postgresql+asyncpg://finora_app:CHANGE_ME@localhost:5432/finora
FINORA_REDIS_URL=redis://localhost:6379/0
# ES256 (P-256) private key, PEM
FINORA_JWT_PRIVATE_KEY=
# 32 bayt tasodifiy, base64:  python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
FINORA_OTP_HMAC_KEY=
FINORA_BLIND_INDEX_KEY=
FINORA_FIELD_ENCRYPTION_KEY=
# Kalit almashtirish: joriy versiya va eski kalitlar "1:<base64>" (keyin: jobs reencrypt-phones)
FINORA_FIELD_ENCRYPTION_KEY_VERSION=1
FINORA_FIELD_ENCRYPTION_KEYS_PREVIOUS=
FINORA_REFRESH_TOKEN_PEPPER=
FINORA_URL_SIGNING_KEY=
FINORA_CLAMAV_HOST=

# SMS: console (faqat dev) | eskiz | playmobile. Zaxira provayder asosiy ishlamasa ishlatiladi
FINORA_SMS_PROVIDER=console
FINORA_SMS_FALLBACK_PROVIDER=
FINORA_ESKIZ_EMAIL=
FINORA_ESKIZ_PASSWORD=
FINORA_ESKIZ_SENDER=4546
FINORA_PLAYMOBILE_LOGIN=
FINORA_PLAYMOBILE_PASSWORD=
FINORA_PLAYMOBILE_ORIGINATOR=3700

# Telegram bot orqali OTP (bo'sh — faqat SMS).
# Prod: python -m app.telegram_setup <https-url>; lokal: python -m app.telegram_poll
FINORA_TELEGRAM_BOT_TOKEN=
FINORA_TELEGRAM_WEBHOOK_SECRET=
FINORA_TELEGRAM_BOT_USERNAME=

# Play Integrity / App Attest majburiymi (verifier ulangandan keyin true)
FINORA_ATTESTATION_REQUIRED=false

# Push: kamida bittasi prod'da majburiy
FINORA_FCM_SERVICE_ACCOUNT_JSON=
FINORA_APNS_TEAM_ID=
FINORA_APNS_KEY_ID=
FINORA_APNS_PRIVATE_KEY=
FINORA_APNS_BUNDLE_ID=
FINORA_APNS_SANDBOX=false

# Yopiq S3-mos bucket (prod'da majburiy). O'zbekistondagi provayder endpoint'i
FINORA_S3_BUCKET=
FINORA_S3_ENDPOINT_URL=
FINORA_S3_REGION=
FINORA_S3_KMS_KEY_ID=

# Prometheus /metrics uchun Bearer token (bo'sh — endpoint o'chiq)
FINORA_METRICS_TOKEN=
FINORA_SECURITY_CONTACT=mailto:security@example.com
FINORA_DOCS_ENABLED=true
FINORA_ENFORCE_HTTPS=false

# Audit retention job'i (finora_owner roli). API bu ulanishni ishlatmaydi
FINORA_MAINTENANCE_DATABASE_URL=

# PDF eksport shrifti (kirill uchun). Docker image'da DejaVuSans o'rnatilgan
FINORA_PDF_FONT_PATH=
# Valyuta kurslari (CBU)
FINORA_CBU_RATES_URL=https://cbu.uz/uz/arkhiv-kursov-valyut/json/

# Yordam: aloqa va live chat identity verification kaliti (bo'sh — chat o'chiq)
FINORA_SUPPORT_TELEGRAM=@finora_support
FINORA_SUPPORT_PHONE=+998 71 200 00 00
FINORA_SUPPORT_EMAIL=help@finora.uz
FINORA_SUPPORT_CHAT_PROVIDER=chatwoot
FINORA_SUPPORT_CHAT_SECRET=
